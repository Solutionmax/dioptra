{
  "name": "migratiebrowser",
  "productName": "Dioptra",
  "desktopName": "migratiebrowser.desktop",
  "version": "1.0.0",
  "description": "A browser with per-domain IP overrides for migration testing",
  "author": {
    "name": "SolutionMAX",
    "url": "https://solutionmax.net"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.cjs test/crx.test.cjs test/claude-network.test.cjs test/library.test.cjs test/live-proxy.test.cjs test/differences.test.cjs test/site-detect.test.cjs test/dns-records.test.cjs test/claude-update.test.cjs",
    "test:site": "node test/site-data.cjs",
    "test:browser": "node test/browser.cjs",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never -c.extraMetadata.name=Dioptra",
    "test:claude": "node test/claude.cjs",
    "test:claude-session": "node test/claude-session.cjs",
    "test:workspace": "node test/workspace.cjs",
    "test:routebar": "node test/routebar.cjs",
    "test:drag": "node test/compare-drag.cjs",
    "test:servers": "node test/servers.cjs",
    "test:quit": "node test/early-quit.cjs",
    "test:scene": "node test/scene.cjs",
    "test:onboarding": "node test/onboarding.cjs",
    "test:settings-library": "node test/settings-library.cjs",
    "test:claude-update": "node test/claude-update.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "net.solutionmax.migratiebrowser",
    "icon": "build/icon.png",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/app-update.yml",
        "to": "app-update.yml"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "artifactName": "Dioptra-${version}-${os}-${arch}.${ext}",
    "linux": {
      "category": "Network",
      "target": [
        "AppImage",
        "deb"
      ],
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "identity": "-",
      "sign": "./scripts/sign-mac.cjs"
    },
    "publish": {
      "provider": "generic",
      "url": "https://github.com/Solutionmax/dioptra/releases/latest/download/"
    },
    "copyright": "Copyright © 2026 SolutionMAX",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "deb": {
      "artifactName": "Dioptra-${version}-ubuntu-amd64.${ext}",
      "maintainer": "SolutionMAX",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1",
        "libasound2t64 | libasound2"
      ]
    }
  },
  "homepage": "https://solutionmax.net"
}
